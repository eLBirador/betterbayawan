{
  "name": "betterbayawan",
  "version": "1.1.19",
  "description": "Independent, source-linked civic information for Bayawan City, Negros Oriental",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/fetch-boundary.mjs && node scripts/build.mjs",
    "geo:fetch": "node scripts/fetch-boundary.mjs",
    "preview": "node scripts/static-server.mjs dist",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test-browser.mjs",
    "i18n:extract": "node scripts/extract-translations.mjs",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "bayawan",
    "negros-oriental",
    "government",
    "lgu"
  ],
  "author": "Rodney Dela Cruz",
  "license": "MIT",
  "devDependencies": {
    "cheerio": "^1.1.2",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
